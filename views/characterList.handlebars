<div>this is the character page for {{sysName}}</div>

<div id="character-list">
    {{#each sheetContext.charactersList}}
        <div class="character-entry" data-id="{{id}}">
            <image src="{{image}}"></image>
            <a href="/character/{{../sysName}}/{{id}}">{{name}}</a>
        </div>
    {{/each}}
</div>

<!--additional file dependencies-->
<link rel="stylesheet" href="/soa.css"/>