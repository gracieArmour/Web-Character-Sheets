<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="/style.css">
        <script type="text/javascript" src="/crossFileUtils.js" defer></script>
        <script type="text/javascript" src="/index.js" defer></script>
        <script type="text/javascript" src="/basicPropertyEntry.js" defer></script>
        <!-- Handlebars external library-->
        <script src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.runtime.js" type="text/javascript"></script>
        <!-- SimpleMDE external library: https://github.com/sparksuite/simplemde-markdown-editor -->
        <link rel="stylesheet" href="https://cdn.rawgit.com/CoffeePerry/simplemde-theme-bootstrap-dark/master/dist/simplemde-theme-bootstrap-dark.min.css">
        <script src="https://cdn.jsdelivr.net/simplemde/latest/simplemde.min.js"></script>
    </head>
    <body>
        {{> header}}
        {{> navbar this}}

        <main id="main-content">
            <div id="system-header">
                <h2>{{sysName}}</h2>
                {{> utilbar this}}
            </div>

            {{{body}}}

            {{#if loggedin}}
            {{else}}
                {{> loginModal}}
            {{/if}}

            <input id="csrfToken" class="hidden" value="{{csrfToken}}"/>
        </main>
    </body>
</html>