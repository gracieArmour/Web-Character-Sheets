<form id="character-sheet" method="post" data-charid="{{sheetContext.charID}}">
    {{> basicInfo sheetContext}}

    <div id="section-container">
        <div id="left-section" class="split-section">
            <div id="playbook-section" class="container">
                <div id="playbook-container">
                    <label>Playbooks</label>
                    <div id="playbook-dropdown-container" class="dropdown-container">
                        <input id="playbook-search" class="search-bar dropdown-toggle" placeholder="search" onkeyup="playbookFilter()">
                        <ul id="playbook-dropdown" class="playbook-list hidden">
                            {{#each sheetContext.allPlaybooks}}
                                <li class="playbook-list-entry">{{this}}</li>
                            {{/each}}
                        </ul>
                    </div>
                    <div id="playbook-list" class="list">
                        {{#each sheetContext.playbooks}}
                            <div class="playbook-entry">
                                <label>{{this}}</label>
                                <button id="delete-playbook-button">x</button>
                            </div>
                        {{/each}}
                    </div>
                </div>

                <div id="level-container">
                    <label>Level</label>
                    <button id="modify-level-button">+</button>
                    <div id="level-value" class="big-number">0</div>
                </div>
            </div>

            <div id="stats-section" class="container">
                {{#each sheetContext.statsList}}
                    {{> soaStatBox}}
                {{/each}}
            </div>

            <div id="combat-section" class="container">
                <div id="hp-container" class="combat-container">
                    <label>Hit Points</label>
                    <input id="hp-display" class="big-number" value="{{sheetContext.current_hp}}" oninput="this.nextElementSibling.value = this.value">
                    <input id="hp-slider" type="range" value="{{sheetContext.current_hp}}" min="0" max="{{sheetContext.max_hp}}" oninput="this.previousElementSibling.value = this.value">
                </div>

                <div id="armor-container" class="combat-container">
                    <label>Armor</label>
                    <input id="armor-value" class="big-number" value="{{sheetContext.armor}}">
                </div>

                <div "damage-container" class="combat-container">
                    <label>Damage</label>
                    <input id="damage-value" value="{{sheetContext.damage}}">
                </div>
            </div>

            <div id="equipment-section" class="container list-section">
                <label>Equipment</label>
                <div id="equipment-dropdown-container" class="dropdown-container">
                        <input id="equipment-search" class="search-bar dropdown-toggle" placeholder="search" onkeyup="equipmentFilter()">
                        <ul id="equipment-dropdown" class="equipment-list hidden">
                            {{#each sheetContext.allEquipment}}
                                <li class="equipment-list-entry">{{this}}</li>
                            {{/each}}
                        </ul>
                    </div>
                <button class="add-button" id="add-equipment-button" type="button">Add Item</button>
                <div id="equipment-list" class="list">
                    {{#each sheetContext.equipment}}
                        {{> soaEquipmentEntry}}
                    {{/each}}
                </div>
            </div>

            <div id="moves-section" class="container  list-section">
                <label>Moves</label>
                <div id="move-filter-container" class="filter-container">
                    <div id="move-dropdown-container" class="move-filter dropdown-container">
                        <input id="move-search" class="search-bar dropdown-toggle" placeholder="search" onkeyup="moveFilter()">
                        <div id="move-dropdown" class="dropdown-list hidden">
                            {{#each sheetContext.allMoves}}
                                <div class="move-list-entry" data-moveid="{{id}}" data-type="{{type}}" data-playbook="{{playbook}}">{{name}}</div>
                            {{/each}}
                        </div>
                    </div>

                    <div id="move-type-selector-container" class="move-filter">
                        <label>Type</label>
                        <select id="move-type-selector">
                            <option value="Any">Any</option>
                            {{#each sheetContext.moveTypes}}
                                <option value="{{this}}">{{this}}</option>
                            {{/each}}
                        </select>
                    </div>
                    
                    <div id="move-playbook-selector-container" class="move-filter">
                        <label>Playbook</label>
                        <select id="move-playbook-selector">
                            <option value="Any">Any</option>
                            {{#each sheetContext.playbooks}}
                                <option value="{{this}}">{{this}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div id="classless-toggle-container" class="move-filter">
                        <label>Classless Mode</label>
                        <input id="classless-toggle" type="checkbox">
                    </div>
                </div>
                <button class="add-button" id="add-move-button" type="button">New Move</button>
                <div id="move-list" class="list">
                    {{#each sheetContext.moves}}
                        {{> soaMoveEntry}}
                    {{/each}}
                </div>
            </div>
        </div>

        <div id="right-container" class="split-section">
            <div id="notes-section">
                <label><h2>Notes</h2></label>
                <textarea id="character-notes">{{sheetContext.notes}}</textarea>
            </div>
            <div id="debug-area">
                <pre>{{raw}}</pre>
            </div>
        </div>
    </div>
</form>

<!--additional file dependencies-->
<link rel="stylesheet" href="/soa.css"/>
<script src="/soa.js" defer></script>
<script src="/soaEquipmentEntry.js" defer></script>
<script src="/soaMoveEntry.js" defer></script>
<script src="/soaCustomMoveEntry.js" defer></script>