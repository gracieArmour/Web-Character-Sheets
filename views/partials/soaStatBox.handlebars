<div id="stat-{{statName}}-container" class="stat-container">
    <label>{{statName}}</label>
    <button id="modify-{{statName}}-button" class="modify-stat-button">+</button>
    <input id="stat-{{statName}}-value" class="stat-value big-number" value="{{statValue}}">
    <div id="debility-{{debilityName}}-container" class="debility-conatiner">
        <p id="debility-{{debilityName}}-label" class="debility-label">{{debilityName}}</p>
        <input id="debility-{{debilityName}}-checkbox" class="debility-checkbox" type="checkbox" value="yes" {{#if debilityValue}}checked{{/if}}>
    </div>
</div>