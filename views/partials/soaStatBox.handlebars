<div id="stat-{{stat-name}}-container" class="stat-container">
    <label>{{stat-name}}</label>
    <button id="modify-{{stat-name}}-button" class="modify-stat-button">+</button>
    <input id="stat-{{stat-name}}-value" class="stat-value big-number" value="{{stat-value}}">
    <div id="debility-{{debility-name}}-container" class="debility-conatiner">
        <p id="debility-{{debility-name}}-label" class="debility-label">{{debility-name}}</p>
        <input id="debility-{{debility-name}}-checkbox" class="debility-checkbox" type="checkbox" value="yes" {{#if debility-value}}checked{{/if}}>
    </div>
</div>