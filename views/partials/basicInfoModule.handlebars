<div id="main-info-container">
    <input id="name-input" class="savable" placeholder="Name" name="name" value="{{name}}"/>
    <div id="main-info">
        <div id="character-img-container">
            <img id="character-img" class="savable save-img" name="image_url" onload="this.style.height = 'fit-content'" src="{{image_url}}"/>
            <button id="character-img-edit-button" type="button">✎</button>
            <input id="character-img-input" class="hidden" placeholder="Image URL" value="{{image_url}}"/>
        </div>
        
        <div id="character-properties-container">
            <ul id="basic-properties-list">
                {{#each basic_properties}}
                    <li class="character-property">
                        <label>{{name}}</label>
                        <input id="{{name}}-input" class="savable save-bProps" name="{{name}}" value="{{value}}"/>
                        <button class="delete-basic-property-button" onclick="deleteHandler(this,'.character-property')">x</button>
                    </li>
                {{/each}}
            </ul>
            <button class="add-button" id="add-basic-property-button" type="button">Add Property</button>
        </div>
    </div>
</div>