<form class="entry spell-entry" method="post">
    <div class="entry-name spell-input">
        <label>
            <input name="spell-name" placeholder="Name" value="{{spell-name}}"/>
        </label>
    </div>
    <div class="entry-description spell-input">
        <label>
            Description
            <textarea name="spell-description">{{spell-description}}</textarea>
        </label>
    </div>
    <div class="entry-source spell-input">
        <label>
            Source
            <input name="spell-source" value="{{spell-source}}"/>
        </label>
    </div>
</form>