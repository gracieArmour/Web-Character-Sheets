<form class="entry spell-entry" method="post">
    <div class="entry-name spell-input">
        <label>
            <input name="spell-name" placeholder="Name" value="{{name}}"/>
        </label>
    </div>
    <div class="entry-description spell-input">
        <textarea name="spell-description" placeholder="Description">{{desc}}</textarea>
    </div>
    <div class="entry-source spell-input">
        <input name="spell-source" placeholder="Source" value="{{source}}"/>
    </div>
</form>