<div class="entry move-entry savable save-customMoves" data-moveid="{{id}}" data-type="{{type}}">
    <div class="move-name-container">
        <label>
            <input name="move-name" placeholder="Name" value="{{name}}"/>
        </label>
        <select name="type" value="{{type}}" oninput="this.parentNode.parentNode.data-type = this.value">
            {{#if type}}
            {{else}}
                <option value="" selected disabled hidden>Move Type</option>
            {{/if}}
            <option value="Background">Background</option>
            <option value="Starting Character">Starting Character</option>
            <option value="5th Lvl Character">5th Lvl Character</option>
            <option value="Core">Core</option>
            <option value="Advanced">Advanced</option>
            <option value="6th Lvl Advanced">6th Lvl Advanced</option>
            <option value="School">School</option>
            <option value="Invocation">Invocation</option>
        </select>
        <div class="move-util-container entry-util-container">
            <button class="collapse-move-button collapse-button" onclick="collapseContent(this)">{{#if is_expanded}}Collapse{{else}}Expand{{/if}}</button>
            <button class="move-up-button move-entry-button" onclick="shiftUp(this.closest('.move-entry'))">^</button>
            <button class="move-down-button move-entry-button" onclick="shiftDown(this.closest('.move-entry'))">⌄</button>
            <button class="delete-move-button" onclick="deleteHandler(this,'.move-entry')">x</button>
        </div>
    </div>
    <div class="move-info entry-info" {{#if is_expanded}}style="min-height: 100px; max-height: fit-content;"{{/if}}>
        <textarea class="entry-description" name="move-description" placeholder="Description">{{description}}</textarea>
    </div>
</div>