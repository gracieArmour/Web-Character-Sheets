<form class="entry move-entry" method="post">
    <div class="entry-name move-input">
        <label>
            <input name="move-name" placeholder="Name" value="{{name}}"/>
        </label>
    </div>
    <div class="entry-description move-input">
        <textarea name="move-description" placeholder="Description">{{desc}}</textarea>
    </div>
    <div class="entry-source move-input">
        <input name="move-source" placeholder="Source" value="{{source}}"/>
    </div>
</form>