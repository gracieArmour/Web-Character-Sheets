<form class="entry move-entry" method="post">
    <div class="entry-name move-input">
        <label>
            <input name="move-name" placeholder="Name" value="{{move-name}}"/>
        </label>
    </div>
    <div class="entry-description move-input">
        <label>
            Description
            <textarea name="move-description">{{move-description}}</textarea>
        </label>
    </div>
    <div class="entry-source move-input">
        <label>
            Source
            <input name="move-source" value="{{move-source}}"/>
        </label>
    </div>
</form>