<div class="entry item-entry savable save-customEquips" data-equipid="{{id}}">
    <div class="item-name-container">
        <label>
            <input name="item-name" placeholder="Name" value="{{name}}"/>
        </label>
        <select name="type" value="{{type}}">
            {{#if type}}
            {{else}}
                <option value="" selected disabled hidden>Type</option>
            {{/if}}
            <option value="Gear">Gear</option>
            <option value="Remedies">Remedies</option>
            <option value="Poison">Poison</option>
        </select>
        <div class="item-util-container entry-util-container">
            <button class="collapse-equipment-button collapse-button" onclick="collapseContent(this)">{{#if is_expanded}}Collapse{{else}}Expand{{/if}}</button>
            <button class="move-up-button move-entry-button" onclick="shiftUp(this.closest('.item-entry'))">^</button>
            <button class="move-down-button move-entry-button" onclick="shiftDown(this.closest('.item-entry'))">⌄</button>
            <button class="delete-equipment-button" onclick="deleteHandler(this,'.item-entry')">x</button>
        </div>
    </div>
    <div class="item-info entry-info" {{#if is_expanded}}style="min-height: 100px; max-height: fit-content;"{{/if}}>
        <textarea class="entry-description" name="item-description" placeholder="Description">{{description}}</textarea>
        <div class="item-uses">
            <label>Uses</label>
            <input type="number" class="big-number" name="item-amount" value="{{uses}}"/>
        </div>
    </div>
    <div class="item-cost-container">
        <label>Cost:</label>
        <input class="big-number" name="item-cost" value="{{cost}}"/>
    </div>
</div>