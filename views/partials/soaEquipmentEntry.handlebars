<form class="entry item-entry" method="post">
    <label>
        <input name="item-name" placeholder="Name" value="{{name}}"/>
    </label>
    <div class="item-info entry-info">
        <textarea class="entry-description" name="item-description" placeholder="Description">{{desc}}</textarea>
        <div class="item-uses">
            <label>Uses</label>
            <input type="number" class="big-number" name="item-amount" value="{{uses}}"/>
        </div>
    </div>
</form>