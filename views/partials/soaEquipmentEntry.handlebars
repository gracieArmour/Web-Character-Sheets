<div class="entry item-entry savable save-equipment" data-equipid="{{id}}">
    <div class="item-name-container">
        <label><a href="{{link}}">{{name}}</a></label>
        <button class="collapse-equipment-button collapse-button" onclick="collapseContent(this)">Expand</button>
        <button class="delete-equipment-button" onclick="deleteHandler(this,'.item-entry')">x</button>
    </div>
    <div class="item-info entry-info">
        <div class="entry-description">{{description}}</div>
        <div class="item-uses">
            <label>Uses</label>
            <input type="number" class="big-number" name="item-amount" value="{{#if uses}}{{uses}}{{else}}{{base_uses}}{{/if}}"/>
        </div>
    </div>
</div>